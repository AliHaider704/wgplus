# Copy to keystore.properties and fill in your own values.
# Create a key with:
#   keytool -genkeypair -v -keystore app/my-release.p12 -storetype PKCS12 -alias wgplus -keyalg RSA -keysize 2048 -validity 36500
storeFile=app/my-release.p12
storePassword=CHANGE_ME
keyAlias=wgplus
keyPassword=CHANGE_ME
